# ---------------------------------------------------------------------------
# Kekenik Pixel — Git ignore rules
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# Build output (regenerated by `npm run build` / `npm run dist:*`)
dist/
dist-electron/
release/
*.tsbuildinfo
coverage/
.vite/
.vite-cache/

# Local env / secrets (never commit certificates or tokens)
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.cer
*.key
csc.link

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Editors & OS noise
.vscode/*
!.vscode/extensions.json
!.vscode/settings.sample.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
*.local

# Transient Electron/electron-builder caches
.builder-cache/
electron-dist/

# NOTE: `assets/icon/*` and `build/*.bmp` are *intentionally committed* —
# they are deterministic outputs of `npm run generate:icons` and are required by
# the test suite, electron-builder, and the NSIS installer.
